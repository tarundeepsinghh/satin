# Production domain (no trailing slash). Used for canonical URLs, OG, sitemap, robots.
PUBLIC_SITE_URL=https://www.satinbysukhmani.com

# Resend — https://resend.com/api-keys (server-only, never exposed to the browser)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Inbox that receives enquiries
ENQUIRY_TO_EMAIL=owner@example.com
# Must be on a domain verified in Resend, e.g. "Satin by Sukhmani <enquiries@your-domain.com>"
ENQUIRY_FROM_EMAIL="Satin by Sukhmani <enquiries@your-verified-domain.com>"

# Optional: force noindex on a build (e.g. staging on a custom domain)
# NOINDEX=true
