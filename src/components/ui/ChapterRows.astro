---
// Collections as editorial "chapters": arch photo + an outlined roman numeral and a
// paper plaque that overlap the photo's edge, alternating sides.
import Photo from './Photo.astro';
import { getCollections, getDesigns } from '@/lib/content';

const collections = await getCollections();
const designs = await getDesigns();
const count = (id: string) => designs.filter((d) => d.data.collection.id === id).length;
---

<ol class="flex flex-col gap-14 md:gap-24">
  {collections.map((c, i) => {
    const flip = i % 2 === 1;
    return (
      <li>
        <a href={`/collections/${c.id}`} class:list={['group relative flex items-end', flip && 'flex-row-reverse']}>
          <div class="relative w-[60%] shrink-0 md:w-[42%] lg:w-[36%]">
            <div class="arch-frame hidden md:block"></div>
            <div class="arch relative aspect-[3/4] bg-pink-deep">
              {c.data.cover && (
                <Photo src={c.data.cover.src} alt={c.data.cover.alt} sizes="(min-width: 64rem) 36vw, (min-width: 48rem) 42vw, 60vw" class="transition-transform duration-[1.6s] ease-(--ease-silk) group-hover:scale-[1.05]" />
              )}
            </div>
          </div>

          <div class:list={['relative z-10 mb-6 min-w-0 flex-1 md:mb-16', flip ? '-mr-[14%] md:-mr-[6%]' : '-ml-[14%] md:-ml-[6%]']}>
            <span class:list={['pointer-events-none block font-display text-[5.5rem] leading-[0.8] text-outline md:text-[11rem]', flip ? 'text-left' : 'text-right md:text-left']} aria-hidden="true">{c.data.numeral}</span>
            <div class="bg-paper px-4 py-4 shadow-[0_1px_0_var(--color-line-strong)] md:max-w-xl md:px-8 md:py-7">
              <p class="label">Chapter {c.data.numeral} · {count(c.id)} designs</p>
              <h3 class="mt-1.5 font-display text-[1.55rem] leading-tight tracking-[0.04em] transition-colors group-hover:text-rose md:text-5xl">{c.data.name}</h3>
              <p class="mt-3 hidden text-ink/75 md:block">{c.data.summary}</p>
              <span class="label link-line mt-3 inline-block text-ink md:mt-5">Explore</span>
            </div>
          </div>
        </a>
      </li>
    );
  })}
</ol>
