---
// One image component for local (ImageMetadata) and remote (Shopify CDN) photos.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, alt, sizes = '(min-width: 64rem) 25vw, 50vw', widths = [400, 640, 960, 1280], priority = false, class: className, style } = Astro.props;
// `width` = largest srcset entry, so the src fallback reuses it instead of a full-size copy.
// Remote URLs need inferSize (dimensions fetched at build); local imports carry their own.
const source = (typeof src === 'string' ? { src, inferSize: true } : { src }) as { src: ImageMetadata };
---

<Image
  {...source}
  alt={alt}
  widths={widths}
  width={Math.max(...widths)}
  sizes={sizes}
  layout="none"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class:list={['size-full object-cover', className]}
  style={style}
/>
