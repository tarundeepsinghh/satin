---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Blossom from '@/components/brand/Blossom.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="bg-pink">
    <div class="container-x flex min-h-[70dvh] flex-col items-center justify-center gap-6 py-20 text-center">
      <Blossom size={64} veins draw class="text-ink" />
      <p class="label">Error 404</p>
      <h1 class="max-w-xl text-4xl tracking-[0.05em] md:text-6xl">This page has wandered off.</h1>
      <p class="max-w-sm text-ink/75">The design you're looking for may have moved. Try the collections instead.</p>
      <div class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/collections" class="btn btn-solid">Explore collections</a>
        <a href="/" class="btn btn-line">Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>
