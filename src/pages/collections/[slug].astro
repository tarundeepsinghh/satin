---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DesignCard from '@/components/ui/DesignCard.astro';
import Photo from '@/components/ui/Photo.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CustomCta from '@/components/ui/CustomCta.astro';
import { breadcrumbLd, collectionPageLd } from '@/lib/seo';
import { getCollections, getDesignsInCollection, type Collection } from '@/lib/content';

export async function getStaticPaths() {
  const collections = await getCollections();
  return collections.map((collection, i) => ({
    params: { slug: collection.id },
    props: { collection, next: collections[(i + 1) % collections.length] },
  }));
}

const { collection, next } = Astro.props as { collection: Collection; next: Collection };
const { data } = collection;
const base = Astro.site!;
const path = `/collections/${collection.id}`;
const designs = await getDesignsInCollection(collection.id);
const { Content } = await render(collection);
const description = data.seo?.description ?? data.summary;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Collections', path: '/collections' }, { name: data.name, path }];
const share = data.cover && (await getImage({ src: data.cover.src, ...(typeof data.cover.src === 'string' && { inferSize: true }), layout: 'none', width: 1200, format: 'jpg' }));
---

<BaseLayout
  title={data.seo?.title ?? data.name}
  description={description}
  image={share?.src}
  imageAlt={data.cover?.alt}
  noindex={data.draft}
  pageEvent={{ name: 'collection_view', collection: collection.id }}
  jsonLd={[
    breadcrumbLd(crumbs, base),
    collectionPageLd({ name: data.name, description, path, items: designs.map((d) => ({ name: d.data.name, path: `/designs/${d.id}` })) }, base),
  ]}
>
  <!-- Hero: outlined chapter numeral behind an arch cover; the title plaque overlaps the arch -->
  <section class="relative overflow-hidden bg-pink pt-5 pb-14 md:pt-8 md:pb-20">
    <div class="container-x relative z-20"><Breadcrumbs items={crumbs} /></div>
    <span aria-hidden="true" class="pointer-events-none absolute top-12 left-1/2 -translate-x-1/2 font-display text-[58vw] leading-none text-outline lg:top-6 lg:left-[30%] lg:text-[26rem]">{data.numeral}</span>
    <div class="relative container-x mt-8 grid items-end lg:grid-cols-[1fr_1fr]">
      {data.cover && (
        <div class="relative mx-auto w-[70%] max-w-sm lg:mr-0 lg:ml-auto lg:w-[78%] lg:max-w-md">
          <div class="arch-frame"></div>
          <div class="arch relative aspect-[3/4] bg-pink-deep">
            <Photo src={data.cover.src} alt={data.cover.alt} priority sizes="(min-width: 64rem) 36vw, 70vw" />
          </div>
        </div>
      )}
      <div class="relative z-10 mx-auto -mt-14 w-[92%] bg-paper px-6 py-7 text-center lg:mx-0 lg:mb-20 lg:-ml-24 lg:w-auto lg:max-w-xl lg:px-12 lg:py-12 lg:text-left">
        <p class="label">Chapter {data.numeral} · {designs.length} designs</p>
        <h1 class="mt-3 text-[2.4rem] leading-[1.05] tracking-[0.05em] md:text-6xl">{data.name}</h1>
        <div class="prose-satin mx-auto mt-4 max-w-md lg:mx-0"><Content /></div>
      </div>
    </div>
  </section>

  <section class="container-x py-12 md:py-20">
    <div class="grid grid-cols-2 gap-x-4 gap-y-12 md:gap-x-6 md:gap-y-16 lg:grid-cols-3">
      {designs.map((d, i) => <DesignCard design={d} index={i} sizes="(min-width: 64rem) 30vw, 48vw" />)}
    </div>
  </section>

  <a href={`/collections/${next.id}`} class="group block border-t border-line">
    <div class="container-x flex items-center justify-between gap-6 py-10 md:py-14">
      <span class="flex flex-col gap-2">
        <span class="label">Next chapter · {next.data.numeral}</span>
        <span class="font-display text-3xl tracking-[0.05em] transition-colors group-hover:text-rose md:text-5xl">{next.data.name}</span>
      </span>
      <svg viewBox="0 0 24 24" class="size-6 shrink-0 transition-transform duration-500 group-hover:translate-x-1.5" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
    </div>
  </a>

  <CustomCta />
</BaseLayout>
