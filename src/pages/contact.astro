---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import Blossom from '@/components/brand/Blossom.astro';
import { site } from '@/config/site';
import { breadcrumbLd } from '@/lib/seo';
import { whatsappUrl } from '@/lib/whatsapp';

const base = Astro.site!;
const channels = [
  { label: 'WhatsApp', value: 'Chat with the atelier', href: whatsappUrl('Hi, I found you through your website.'), track: 'whatsapp_click', external: true },
  { label: 'Instagram', value: site.instagramHandle ?? 'Follow the atelier', href: site.instagramUrl, track: 'instagram_click', external: true },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
];
---

<BaseLayout
  title="Contact"
  description="Contact Satin by Sukhmani on WhatsApp, Instagram or email — for design enquiries, custom outfits and sizing questions."
  jsonLd={[breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }], base)]}
>
  <section class="container-x grid gap-14 py-12 md:py-20 lg:grid-cols-[1fr_1.4fr] lg:gap-24">
    <div class="flex flex-col gap-6">
      <SectionHead label="Contact" title="Say hello." as="h1" />
      <p class="max-w-sm text-ink/80">For questions about a design, sizing or a custom outfit, WhatsApp is the quickest way to reach us.</p>
      {site.location && <p class="label">{site.location.city}, {site.location.region}</p>}
      <Blossom size={40} stroke={2.6} class="mt-4 hidden text-mauve lg:block" />
    </div>

    <ul class="border-b border-line-strong">
      {channels.map((c) => (
        <li>
          <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} data-track={c.track} data-location="contact" class="group flex items-center justify-between gap-6 border-t border-line-strong py-7 md:py-9">
            <span class="flex flex-col gap-2">
              <span class="label">{c.label}</span>
              <span class="font-display text-2xl tracking-[0.04em] break-all transition-colors group-hover:text-rose md:text-4xl">{c.value}</span>
            </span>
            {c.label === 'WhatsApp' ? <WhatsAppIcon class="size-6 shrink-0" /> : (
              <svg viewBox="0 0 24 24" class="size-6 shrink-0 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-pink">
    <div class="container-x flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center">
      <div>
        <p class="label">Have something particular in mind?</p>
        <p class="mt-2 font-display text-2xl tracking-[0.04em] md:text-3xl">Start a custom-made enquiry.</p>
      </div>
      <a href="/custom-made" class="btn btn-solid w-full md:w-auto">Custom Made</a>
    </div>
  </section>
</BaseLayout>
