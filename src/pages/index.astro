---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Blossom from '@/components/brand/Blossom.astro';
import Photo from '@/components/ui/Photo.astro';
import DesignCard from '@/components/ui/DesignCard.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import ChapterRows from '@/components/ui/ChapterRows.astro';
import CustomCta from '@/components/ui/CustomCta.astro';
import { site, craft } from '@/config/site';
import { editorial, pick, picks } from '@/config/editorial';
import { organizationLd, websiteLd } from '@/lib/seo';
import { getDesigns } from '@/lib/content';

const base = Astro.site!;
const designs = await getDesigns();
const [heroLeft, hero, heroRight] = await picks(editorial.hero);
const [pic1, pic2, pic3] = await picks(editorial.inline);
const craftShot = await pick(editorial.craft);
const lookbook = await picks(editorial.lookbook);
const featured = designs.filter((d) => d.data.featured && d.id !== editorial.hero[1][0]).slice(0, 8);

// Poetic single-word names for the marquee (Aasmaan, Chand, Meera…)
const names = [...new Set(designs.map((d) => d.data.name.split(/ — | Kurta| Pants/)[0]).filter((n) => !/\s/.test(n)))];
const inlineSizes = '96px';
const inlineWidths = [160, 320];
---

<BaseLayout jsonLd={[organizationLd(base), websiteLd(base)]}>
  <!-- ── Cover: masthead behind the arch, like a magazine cover ─────────── -->
  <section class="relative overflow-hidden bg-pink pt-6 pb-12 md:pt-10 md:pb-20">
    <h1 class="sr-only">Satin by Sukhmani — {site.tagline}</h1>
    <p aria-hidden="true" class="relative z-0 text-center font-display text-[22vw] leading-[0.82] tracking-[0.12em] text-ink uppercase lg:text-[17vw]" style="margin-right:-.12em">Satin</p>

    <div class="relative z-10 mx-auto -mt-[5vw] w-[74%] max-w-[26rem] lg:-mt-[5vw] lg:w-[30%] lg:max-w-none">
      <div class="arch-frame"></div>
      <a href={hero.href} class="arch relative block aspect-[3/4] bg-pink-deep" aria-label={`View ${hero.name}`}>
        <Photo src={hero.src} alt={hero.alt} priority sizes="(min-width: 64rem) 30vw, 74vw" />
      </a>
      <p class="label mt-4 flex justify-between"><span>Look 01</span><span class="text-ink">{hero.name}</span></p>
    </div>

    <!-- Desktop: two smaller arches flanking the cover -->
    <a href={heroLeft.href} class="group absolute bottom-[14%] left-[5%] hidden w-[15%] lg:block" tabindex="-1" aria-hidden="true">
      <div class="arch aspect-[3/4] bg-pink-deep"><Photo src={heroLeft.src} alt="" sizes="15vw" class="transition-transform duration-[1.4s] group-hover:scale-105" /></div>
      <p class="label mt-3">Look 02 — {heroLeft.name}</p>
    </a>
    <a href={heroRight.href} class="group absolute top-[44%] right-[5%] hidden w-[15%] lg:block" tabindex="-1" aria-hidden="true">
      <div class="arch aspect-[3/4] bg-pink-deep"><Photo src={heroRight.src} alt="" sizes="15vw" class="transition-transform duration-[1.4s] group-hover:scale-105" /></div>
      <p class="label mt-3">Look 03 — {heroRight.name}</p>
    </a>

    <div class="relative z-10 mt-8 flex flex-col items-center px-5 text-center">
      <p class="font-display text-[clamp(0.85rem,3.4vw,1.1rem)] tracking-[0.5em] text-rose uppercase" style="margin-right:-.5em">by Sukhmani</p>
      <p class="mt-5 max-w-sm font-display text-[1.5rem] leading-snug tracking-[0.02em] md:max-w-xl md:text-[2rem]">{site.tagline}</p>
      <div class="mt-7 flex w-full max-w-sm flex-col gap-3 sm:w-auto sm:max-w-none sm:flex-row">
        <a href="/collections" class="btn btn-solid">Explore collections</a>
        <a href="/custom-made" class="btn btn-line">Custom-made outfits</a>
      </div>
    </div>
  </section>

  <!-- ── Name marquee (decorative) ───────────────────────── -->
  <div aria-hidden="true" class="overflow-hidden bg-plum py-5">
    <div class="flex w-max animate-[marquee_70s_linear_infinite] motion-reduce:animate-none">
      {[0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {names.map((n) => (
            <li class="flex items-center">
              <span class="px-6 font-display text-2xl tracking-[0.2em] text-on-plum uppercase md:text-3xl">{n}</span>
              <Blossom size={14} stroke={7} class="text-on-plum-muted" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <!-- ── Atelier: a headline with photos set into the words ───────────── -->
  <section class="container-x py-20 md:py-32">
    <p class="label flex items-center gap-3"><span class="h-px w-8 bg-mauve" aria-hidden="true"></span>The Atelier</p>
    <h2 class="mt-6 font-display text-[2.05rem] leading-[1.3] tracking-[0.02em] md:text-[4.2rem] md:leading-[1.2]">
      Indian wear
      <a href={pic1.href} class="inline-pic" aria-label={pic1.name}><Photo src={pic1.src} alt="" sizes={inlineSizes} widths={inlineWidths} /></a>
      by {site.designerName}, embroidered by hand
      <a href={pic2.href} class="inline-pic" aria-label={pic2.name}><Photo src={pic2.src} alt="" sizes={inlineSizes} widths={inlineWidths} /></a>
      and made only for you
      <a href={pic3.href} class="inline-pic" aria-label={pic3.name}><Photo src={pic3.src} alt="" sizes={inlineSizes} widths={inlineWidths} /></a>
      — in silk, organza and chanderi.
    </h2>
    <div class="mt-10 grid gap-6 md:mt-14 md:grid-cols-[1fr_1fr_auto] md:items-end md:gap-12">
      <p class="text-ink/80">From bridal anarkalis and lehengas to sharara sets, co-ords and embroidered bags — worked in zari, dabka, resham and katdana.</p>
      <p class="text-ink/80">Every design is made to order, so sizes and colours can be adapted to the person wearing it.</p>
      <a href="/about" class="label link-line self-start text-ink md:self-end">Meet the designer</a>
    </div>
  </section>

  <!-- ── Chapters (collections) ───────────────────────────── -->
  <section class="bg-paper pb-20 md:pb-32">
    <div class="container-x">
      <SectionHead label="The Collections" title="Five chapters" class="mb-12 md:mb-20" />
      <ChapterRows />
    </div>
  </section>

  <!-- ── Lookbook: arch cards ─────────────────────────────── -->
  <section class="bg-pink py-20 md:py-28">
    <div class="container-x mb-10 flex items-end justify-between gap-6 md:mb-14">
      <SectionHead label="Signature Pieces" title="The lookbook" />
      <a href="/collections" class="label link-line hidden shrink-0 text-ink sm:inline">All designs</a>
    </div>
    <div class="snap-row auto-cols-[68%] gap-4 scroll-px-5 px-5 sm:auto-cols-[40%] lg:container-x lg:grid lg:grid-flow-row lg:grid-cols-4 lg:gap-x-6 lg:gap-y-16 lg:[&>*:nth-child(even)]:translate-y-14">
      {featured.map((d, i) => <DesignCard design={d} index={i} sizes="(min-width: 64rem) 23vw, 68vw" />)}
    </div>
    <div class="container-x mt-10 sm:hidden"><a href="/collections" class="btn btn-line w-full">All designs</a></div>
  </section>

  <!-- ── Photo wall with a floating plaque ────────────────── -->
  <section aria-label="From the lookbook" class="relative bg-plum">
    <ul class="grid grid-cols-3 gap-px md:grid-cols-6">
      {lookbook.map((img) => (
        <li>
          <a href={img.href} class="group relative block aspect-[3/4] overflow-hidden" title={img.name}>
            <Photo src={img.src} alt={img.alt} sizes="(min-width: 48rem) 17vw, 33vw" class="transition duration-700 group-hover:scale-105" />
          </a>
        </li>
      ))}
    </ul>
    <div class="pointer-events-none absolute inset-0 grid place-items-center p-6">
      <div class="pointer-events-auto flex max-w-xs flex-col items-center gap-4 bg-pink px-7 py-8 text-center shadow-[0_20px_60px_-20px_rgb(39_24_32/0.5)] md:max-w-sm md:px-10 md:py-10">
        <div class="relative grid size-16 place-items-center border border-ink" aria-hidden="true">
          <div class="absolute inset-1 border border-frame"></div>
          <Blossom size={30} stroke={2.8} class="text-ink" />
        </div>
        <p class="font-display text-[1.6rem] leading-tight tracking-[0.04em] md:text-3xl">From the atelier, as it happens.</p>
        <a href={site.instagramUrl} target="_blank" rel="noopener" class="label link-line text-ink" data-track="instagram_click" data-location="photo_wall">Follow on Instagram</a>
      </div>
    </div>
  </section>

  <!-- ── Craft: words over a detail photo ─────────────────── -->
  <section class="relative overflow-hidden bg-plum text-on-plum">
    <div class="absolute inset-0">
      <Photo src={craftShot.src} alt={craftShot.alt} sizes="100vw" class="opacity-45" />
      <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(39_24_32/0.55),rgb(39_24_32/0.85))]"></div>
    </div>
    <div class="relative container-x flex min-h-[38rem] flex-col justify-center gap-8 py-20 md:min-h-[44rem] md:py-28">
      <p class="label flex items-center gap-3 text-on-plum-muted"><span class="h-px w-8 bg-on-plum-muted" aria-hidden="true"></span>The Craft</p>
      <h2 class="max-w-3xl text-[2.6rem] leading-[1.05] tracking-[0.05em] md:text-7xl">Made slowly, by hand.</h2>
      <p class="max-w-md text-on-plum/85">Embroidery is worked stitch by stitch — which is why every piece is made to order, and why no two are ever quite the same.</p>
      <ul class="flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 font-display text-[1.5rem] tracking-[0.12em] uppercase md:text-[2.4rem]">
        {craft.map((c, i) => (
          <li class="flex items-center gap-4">
            <span class={i % 2 ? 'text-outline-light' : 'text-on-plum'}>{c}</span>
            {i < craft.length - 1 && <Blossom size={12} stroke={7} class="text-on-plum-muted/70" />}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CustomCta />
</BaseLayout>
