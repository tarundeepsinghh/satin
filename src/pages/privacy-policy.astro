---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { site } from '@/config/site';

// TODO(owner): review this policy with your own advisor before launch.
const updated = '11 October 2026';
---

<BaseLayout title="Privacy Policy" description="How Satin by Sukhmani collects and uses the information you share through this website.">
  <article class="container-x max-w-3xl py-12 md:py-20">
    <SectionHead label={`Last updated · ${updated}`} title="Privacy Policy" as="h1" class="mb-10" />
    <div class="prose-satin flex flex-col gap-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:tracking-[0.04em] [&_h2]:text-ink">
      <section>
        <h2>What we collect</h2>
        <p>When you send a custom-made enquiry we collect the details you enter: your name, email address, phone number, optional location, outfit preferences, budget, event date and any reference link. We don't collect payment details, and we don't ask for measurements before speaking with you.</p>
      </section>
      <section>
        <h2>How we use it</h2>
        <p>Only to read and reply to your enquiry and to discuss your outfit with you by your preferred contact method. We don't sell or share your details for marketing.</p>
      </section>
      <section>
        <h2>Services we use</h2>
        <ul>
          <li>Enquiries are delivered to our inbox by email through Resend.</li>
          <li>The website is hosted on Vercel.</li>
          <li>If you choose to continue on WhatsApp, your conversation is subject to WhatsApp's own privacy policy.</li>
        </ul>
      </section>
      <section>
        <h2>How long we keep it</h2>
        <p>We keep enquiry emails only as long as needed to respond and to handle any resulting order.</p>
      </section>
      <section>
        <h2>Your choices</h2>
        <p>You can ask us to see, correct or delete the information you sent at any time by writing to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </section>
    </div>
  </article>
</BaseLayout>
